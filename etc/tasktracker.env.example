# Copy to /opt/tasktracker/etc/tasktracker.env on the server (chmod 600).
# Loaded by systemd via EnvironmentFile=.

# Telegram bot token from @BotFather (required to run the bot).
BOT_TOKEN=

# SQLite database path.
DB_PATH=/opt/tasktracker/data/tasks.db

# HTTP listen address for the Mini App (loopback; cloudflared fronts it).
HTTP_ADDR=127.0.0.1:8099

# Tunnel: "on" lets tasktracker manage a cloudflared quick tunnel and
# auto-republish the Mini App URL to the bot menu button. Set "off" if you
# provide a fixed URL below.
TUNNEL=on
CLOUDFLARED_BIN=cloudflared

# Fixed Mini App URL (e.g. https://tasks.example.com). When set, overrides the
# tunnel — use this once you move to a real domain.
# MINIAPP_URL=

LOG_LEVEL=info

# Optional deployment-specific usernames, without @.
MEMBER_ONE_USERNAME=
MEMBER_TWO_USERNAME=
